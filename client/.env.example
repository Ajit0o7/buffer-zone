# Copy to client/.env.local and fill in for your deployment.
# Address of the Socket.io server (no trailing slash).
VITE_SERVER_URL=http://localhost:3001

# Voice chat: STUN/TURN servers, as JSON. The default is Google's public STUN server, which suits most home
# networks. Add a TURN relay for networks that block direct connections (see docs/VOICE.md).
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
